/*
 * Device-tree overlay for the heatguard application on Raspberry Pi Pico.
 *
 * UART0  – GPIO0 (TX) / GPIO1 (RX)  – 115200 baud diagnostic interface
 * I2C1   – GPIO6 (SDA) / GPIO7 (SCL) – 400 kHz  (LM75B sensors + EEPROM)
 * LEDs   – GPIO26-29 (enable / ok / failure / guard)
 * XIAO   – GPIO16 (green, active-low), GPIO17 (red), GPIO25 (blue)
 */

#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			pinmux = <I2C1_SDA_P6>, <I2C1_SCL_P7>;
			input-enable;
			input-schmitt-enable;
		};
	};
};

/* Override console UART baud rate to 115200 for the diagnostic interface */
&uart0 {
	current-speed = <115200>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};
